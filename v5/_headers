# Cloudflare Pages response headers.
#
# Confidential paths (private proposals and their content) must never be stored by a shared
# cache: once an edge cache holds a response, a later deployment that removes or gates the file
# does not evict it (seen 14 Oct 2026 with deleted internal files on freeman-d6f.pages.dev).
# Confidential content is never published as a static .json/.txt/.pdf file; it is served only
# by a Function behind the access gate (docs/access/PHASE-TWO-RUNBOOK.md).

/p
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/p/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/proposal-alder
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/proposal-assets/data/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

# Reserved prefixes for future private material (project-specific ACCESS, staff tools).
/a/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

# Projects map photographs: resized copies with a content hash in the name (studio/map-projects-001/build-photos.mjs).
# A changed photograph gets a new name, so these never need revalidating.
/assets/map/*
  Cache-Control: public, max-age=31536000, immutable

# Public photographs section, dynamically populated from the Freeman Drive folder.
/photographs
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: same-origin

/photograph-files/*
  Cache-Control: public, max-age=31536000, immutable

# Barnsley × AssuranceAmerica (11 Nov 2026): unlisted Drive-backed gallery, never indexed.
/assuranceamerica
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive

# /assuranceamerica films: web versions with a content hash in the name (studio/assuranceamerica-films/build-films.mjs).
/assets/films/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, nofollow, noarchive

# The Built Record (study 001, 13 Nov 2026): unpublished case-study prototype, never indexed.
/built-record/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Freeman Folio (case study system 002, 14 Nov 2026): unpublished case-study prototype, never indexed.
/folio/*
  X-Robots-Tag: noindex, nofollow, noarchive
